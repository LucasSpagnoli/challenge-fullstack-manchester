generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  clients   Clients[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User_preferences {
  id         Int      @id @default(autoincrement())
  topic      String[]
  owner_id   Int      @unique
  created_at DateTime @default(now())
}

model Clients_preferences {
  id         Int      @id @default(autoincrement())
  topic      String[]
  owner_id   Int      @unique
  created_at DateTime @default(now())
}

model User_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  generatedAt  DateTime @default(now())
}

model Client_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  generatedAt  DateTime @default(now())
}

model Clients {
  id          Int      @id @default(autoincrement())
  name        String
  number      String
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id])
}
