generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String
  role        String    @default("user")
  preferences String[]
  clients     Clients[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  generatedAt  DateTime @default(now())
}

model Client_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  summary      String?
  generatedAt  DateTime @default(now())
}

model Clients {
  id          Int      @id @default(autoincrement())
  name        String
  number      String
  user_id     Int
  preferences String[] @default([])
  user        User     @relation(fields: [user_id], references: [id])
}
